# 云南菜价通 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 农业农村部 API ──
# 官方行情接口 AES 解密密钥（生产环境必须通过 Netlify 环境变量注入）
PFSC_AES_KEY=7s9K$pG2xQ8zR5mB7vA3sD9fH2jW40cV

# ── 前端 ──
# API 基础 URL（生产环境留空，使用相对路径）
VITE_API_BASE_URL=

# 是否启用 Mock 数据回落（生产环境建议设为 false）
VITE_ENABLE_MOCK_FALLBACK=true

# ── Netlify ──
# 在 Netlify Dashboard → Site settings → Environment variables 中配置：
#   PFSC_AES_KEY       — AES 解密密钥
#   VITE_ENABLE_MOCK_FALLBACK — 生产环境建议 false
